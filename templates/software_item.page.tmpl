<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IT Soft - {{.order.Title}}</title>
    <link rel="stylesheet" href="/styles/styles_prod.css">
</head>
<body>
<header>
    <div class="logo" onclick="window.location.href='/software'" style="cursor: pointer;">IT Soft</div>
</header>

<main>
    <div class="container">
        <div class="product-layout">
            <div class="image-section">
                <img src="{{.order.ImgURL}}" alt="{{.order.Title}} Logo" class="product-image">
            </div>
            <div class="content-section">
                <h1 class="product-title">{{.order.Title}}</h1>

                <section class="support-info">
                    <div class="support-row">
                        <span class="label">Поддержка:</span>
                        <span class="value">{{.order.OS}}</span>
                    </div>
                    <div class="support-row">
                        <span class="label">Версия:</span>
                        <span class="value">{{.order.Version}}</span>
                    </div>
                    <div class="support-row">
                        <span class="label">Размер:</span>
                        <span class="value">{{.order.Size}} ГБ</span>
                    </div>
                </section>
            </div>
        </div>

        <section class="description">
            <p>{{.order.FullDescription}}</p>
        </section>

        <section class="functions">
            <h2>Основные функции:</h2>
            <div class="functions-text">
                {{.order.Functions}}
            </div>
        </section>
    </div>

    <!-- Корзина -->
    <div class="cart-bottom-left">
        <a href="{{ if gt .cart_count 0 }}/software_request/{{ .request_id }}{{ else }}#{{ end }}">
            <img 
                src="http://127.0.0.1:9000/lb1/cart.png" 
                alt="Cart" 
                class="cart-icon {{ if eq .cart_count 0 }}disabled{{ end }}">
            <span class="cart-count {{ if eq .cart_count 0 }}empty{{ end }}">
                {{ .cart_count }}
            </span>
        </a>
    </div>

</main>
</body>
</html>